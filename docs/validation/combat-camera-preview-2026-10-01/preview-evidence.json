    "exact_diffs": [
      {
        "path": "Assets/CameraFollow.cs",
        "playmode25_sha256": "38fa483dfba83cdae03403961bcf1572811d25ad1a25541acd241131f3dbf08f",
        "editmode9_sha256": "87e06067db7bdb743b892e1bff099f89e43ebc2689684b090d8363bc256a8bed",
        "added_lines": 3,
        "removed_lines": 0,
        "unified_diff": "--- Play25/Assets/CameraFollow.cs\n+++ Edit9/Assets/CameraFollow.cs\n@@ -146,6 +146,9 @@\n         // Keep collision sweeps anchored at the actor. Shoulder and look height\n         // frame the view; the conservative near-plane sphere remains unchanged.\n         Vector3 look = pivot + shoulder * shoulderAimFraction + Vector3.up * lookHeightOffset - candidate;\n+        // A held/smoothed camera can coincide with the shifted aim point.\n+        // The collision-resolved boom still provides a nonzero view direction.\n+        if (look.sqrMagnitude < 0.00000001f) look = pivot - candidate;\n         Vector3 up = Mathf.Abs(Vector3.Dot(look.normalized, Vector3.up)) > 0.999f ? Vector3.forward : Vector3.up;\n         transform.SetPositionAndRotation(candidate, Quaternion.LookRotation(look, up));\n         previousTargetPosition = player.position;\n"
      },
      {
        "path": "Assets/Tests/PlayMode/CameraFollowTests.cs",
        "playmode25_sha256": "eee5f21c6279c444457d52838970ffc6c717c5345b70993a8b6a897bbee3fce8",
        "editmode9_sha256": "e1335840d99a75dc1386faa041c51b11240f58ccdef9f6e44b8ced3d600a141a",
        "added_lines": 19,
        "removed_lines": 0,
        "unified_diff": "--- Play25/Assets/Tests/PlayMode/CameraFollowTests.cs\n+++ Edit9/Assets/Tests/PlayMode/CameraFollowTests.cs\n@@ -450,6 +450,25 @@\n             LogAssert.NoUnexpectedReceived();\n         }\n \n+        [Test]\n+        public void MovingTargetAtHeldCameraAimUsesSafeBoomWithoutInvalidRotation()\n+        {\n+            Set(\"distance\", 1f);\n+            Set(\"height\", 2f);\n+            Set(\"pivotHeight\", 1f);\n+            Set(\"lookHeightOffset\", 1f);\n+            Set(\"smoothSpeed\", 0f);\n+            Assert.That((bool)Call(\"SnapToTarget\"), Is.True);\n+            Vector3 heldPosition = camera.transform.position;\n+            player.transform.position = Vector3.back;\n+            Assert.That(Step(), Is.True);\n+            Assert.That(Vector3.Distance(camera.transform.position, heldPosition), Is.LessThan(.001f));\n+            Assert.That(Vector3.Distance(camera.transform.forward, Vector3.down), Is.LessThan(.001f));\n+            Assert.That(Get<bool>(\"HasSafePose\"), Is.True);\n+            Assert.That(camera.enabled, Is.True);\n+            LogAssert.NoUnexpectedReceived();\n+        }\n+\n         [TestCase(0f, 0f)]\n         [TestCase(1.3f, 1.3f)]\n         [TestCase(-1f, 0f)]\n"
      }
    ],
